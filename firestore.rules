rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helpers
    // ============================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isFriendOf(authorId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(authorId)/friends/$(request.auth.uid));
    }

    function canReadSpotData(spot) {
      return isAuthenticated() && (
        spot.authorId == request.auth.uid ||
        spot.visibility == 'public' ||
        (spot.visibility == 'friends' && isFriendOf(spot.authorId))
      );
    }

    function isTimestampOrNull(value) {
      return value == null || value is timestamp;
    }

    // ============================================================
    // Users + subcollections
    // ============================================================
    match /users/{userId} {
      // Hồ sơ hiển thị công khai cho người dùng đã đăng nhập. Không lưu email/uid trong tài liệu.
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'avatarPath', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'avatarPath', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && (request.resource.data.avatarPath == null ||
            (request.resource.data.avatarPath is string && request.resource.data.avatarPath.size() <= 2048))
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'avatarPath', 'createdAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && (request.resource.data.avatarPath == null ||
            (request.resource.data.avatarPath is string && request.resource.data.avatarPath.size() <= 2048));

      allow delete: if false;

      // Place riêng: geohash bảo vệ như tọa độ. Bất biến sau khi tạo.
      match /privatePlaces/{placeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'name', 'nameNormalized', 'category', 'address',
            'latitude', 'longitude', 'geohash'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 120
          && request.resource.data.nameNormalized is string
          && request.resource.data.category is string
          && request.resource.data.category.size() >= 1
          && request.resource.data.address is string
          && request.resource.data.address.size() >= 1
          && request.resource.data.latitude is number
          && request.resource.data.latitude >= -90.0
          && request.resource.data.latitude <= 90.0
          && request.resource.data.longitude is number
          && request.resource.data.longitude >= -180.0
          && request.resource.data.longitude <= 180.0
          && request.resource.data.geohash is string
          && request.resource.data.geohash.size() >= 1;
        allow update: if false;
        allow delete: if false;
      }

      // Tham chiếu vị trí thật cho Spot hidden. Chỉ chủ đọc; ghi khi tạo Spot.
      match /spotLocations/{spotId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['placeScope', 'placeKey'])
          && request.resource.data.placeScope in ['shared', 'private']
          && request.resource.data.placeKey is string
          && request.resource.data.placeKey.size() >= 1;
        allow update: if false;
        allow delete: if false;
      }

      // Bảng tra cứu quyền bạn bè: chỉ server (Admin SDK) ghi.
      match /friends/{friendUid} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Saved Place: 1 bản ghi/địa điểm. hasVisited và isBookmarked độc lập.
      match /savedPlaces/{key} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'placeScope', 'placeId', 'hasVisited', 'isBookmarked', 'lastVisitedAt'
          ])
          && request.resource.data.placeScope in ['shared', 'private']
          && request.resource.data.placeId is string
          && request.resource.data.placeId.size() >= 1
          && request.resource.data.hasVisited is bool
          && request.resource.data.isBookmarked is bool
          && (request.resource.data.hasVisited == true || request.resource.data.isBookmarked == true)
          && isTimestampOrNull(request.resource.data.get('lastVisitedAt', null));
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'placeScope', 'placeId', 'hasVisited', 'isBookmarked', 'lastVisitedAt'
          ])
          && request.resource.data.placeScope == resource.data.placeScope
          && request.resource.data.placeId == resource.data.placeId
          && request.resource.data.hasVisited is bool
          && request.resource.data.isBookmarked is bool
          && isTimestampOrNull(request.resource.data.get('lastVisitedAt', null));
        // Chỉ xóa bản ghi không còn lịch sử ghé; xóa lần ghé cuối do server tính lại.
        allow delete: if isOwner(userId) && resource.data.hasVisited == false;
      }

      // Thông báo do server tạo; người nhận chỉ đổi isRead.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead is bool;
        allow create, delete: if false;
      }

      // Phần mở rộng giai đoạn 3 (FCM)
      match /pushDevices/{deviceId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['installationId', 'updatedAt'])
          && request.resource.data.installationId is string;
      }
    }

    // ============================================================
    // User settings
    // ============================================================
    match /userSettings/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['defaultVisibility', 'notificationEnabled'])
        && request.resource.data.defaultVisibility in ['public', 'friends', 'private']
        && request.resource.data.notificationEnabled is bool;
      allow delete: if false;
    }

    // ============================================================
    // Shared Places: bất biến sau khi tạo
    // ============================================================
    match /places/{placeId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'name', 'nameNormalized', 'category', 'address',
          'latitude', 'longitude', 'geohash', 'createdBy', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'nameNormalized', 'category', 'address',
          'latitude', 'longitude', 'geohash', 'createdBy', 'createdAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.nameNormalized is string
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 1
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 1
        && request.resource.data.address.size() <= 300
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90.0
        && request.resource.data.latitude <= 90.0
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180.0
        && request.resource.data.longitude <= 180.0
        && request.resource.data.geohash is string
        && request.resource.data.geohash.size() >= 1;

      allow update, delete: if false;
    }

    // ============================================================
    // Spots
    // ============================================================
    match /spots/{spotId} {
      allow read: if canReadSpotData(resource.data);

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'authorId', 'placeId', 'locationMode', 'imagePaths', 'category',
          'priceVnd', 'rating', 'caption', 'visibility', 'visitedAt',
          'createdAt', 'updatedAt', 'status'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.locationMode in ['exact', 'hidden']
        && (
          (request.resource.data.locationMode == 'hidden' && request.resource.data.placeId == null) ||
          (request.resource.data.locationMode == 'exact' &&
            request.resource.data.placeId is string &&
            request.resource.data.placeId.size() >= 1)
        )
        && request.resource.data.imagePaths is list
        && request.resource.data.imagePaths.size() >= 1
        && request.resource.data.imagePaths.size() <= 5
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 1
        && (request.resource.data.priceVnd == null ||
            (request.resource.data.priceVnd is int && request.resource.data.priceVnd >= 0))
        && (request.resource.data.rating == null ||
            (request.resource.data.rating is int &&
             request.resource.data.rating >= 1 &&
             request.resource.data.rating <= 5))
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 1000
        && request.resource.data.visibility in ['public', 'friends', 'private']
        && request.resource.data.get('visitedAt', null) is timestamp
        && request.resource.data.get('status', 'active') == 'active';

      // Chỉ tác giả được đổi visibility; mọi trường còn lại bất biến.
      // created/updated dùng serverTimestamp nên updatedAt == request.time.
      allow update: if isAuthenticated()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorId', 'placeId', 'locationMode', 'imagePaths', 'category',
          'priceVnd', 'rating', 'caption', 'visibility', 'visitedAt',
          'createdAt', 'updatedAt', 'status'
        ])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.placeId == resource.data.placeId
        && request.resource.data.locationMode == resource.data.locationMode
        && request.resource.data.imagePaths == resource.data.imagePaths
        && request.resource.data.category == resource.data.category
        && request.resource.data.priceVnd == resource.data.priceVnd
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.caption == resource.data.caption
        && request.resource.data.get('visitedAt', null) == resource.data.get('visitedAt', null)
        && (
          request.resource.data.get('status', null) == resource.data.get('status', null)
        )
        && request.resource.data.visibility in ['public', 'friends', 'private']
        && request.resource.data.get('updatedAt', null) == request.time;

      // Xóa Spot đi qua Route Handler để dọn likes/ảnh/liên kết và tính lại hasVisited.
      allow delete: if false;

      // Likes: docId = UID; server tạo/xóa và kiểm tra quyền đọc Spot.
      match /likes/{userId} {
        allow read: if isAuthenticated() && canReadSpotData(
          get(/databases/$(database)/documents/spots/$(spotId)).data
        );
        allow write: if false;
      }
    }

    // ============================================================
    // Friendships: client đọc quan hệ của mình; ghi qua server transaction.
    // ============================================================
    match /friendships/{pairId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow write: if false;
    }

    // ============================================================
    // Media metadata: chủ sở hữu ghi, đường dẫn phải khớp UID/spotId.
    // ============================================================
    match /media/{mediaId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['ownerId', 'spotId', 'objectPath', 'status', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.spotId is string
        && request.resource.data.objectPath is string
        && request.resource.data.objectPath.matches(
             'spots/' + request.auth.uid + '/' + request.resource.data.spotId + '/.*'
           )
        && request.resource.data.status in ['temp', 'attached', 'orphan']
        && (request.resource.data.get('createdAt', null) == null ||
            request.resource.data.get('createdAt', null) is timestamp);
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.keys().hasOnly(['ownerId', 'spotId', 'objectPath', 'status', 'createdAt'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.spotId == resource.data.spotId
        && request.resource.data.objectPath == resource.data.objectPath
        && request.resource.data.status in ['temp', 'attached', 'orphan']
        && (request.resource.data.get('createdAt', null) == null ||
            request.resource.data.get('createdAt', null) is timestamp)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
      allow delete: if isOwner(resource.data.ownerId);
    }
  }
}
