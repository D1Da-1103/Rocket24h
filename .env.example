# Cấu hình môi trường cho Rocket24h

# Bật/tắt Firebase Emulator (mặc định: true khi chạy dev/demo)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Thông tin Firebase (Với Emulator, các giá trị này là định danh giả lập)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rocket24h-local
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key-for-local-emulator
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rocket24h-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rocket24h-local.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Cổng Firebase Emulator cho Client & Server
NEXT_PUBLIC_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8080
NEXT_PUBLIC_STORAGE_EMULATOR_HOST=localhost:9199

# Biến môi trường hệ thống cho Firebase Admin SDK
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Bản đồ & Tile Provider (Mặc định OpenStreetMap)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# URL gốc ứng dụng
NEXT_PUBLIC_APP_URL=http://localhost:3000
