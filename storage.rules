rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isUnder5MB() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    function spotIsReadableByViewer(authorUid, spotDocumentId) {
      return firestore.exists(/databases/(default)/documents/spots/$(spotDocumentId))
        && firestore.get(/databases/(default)/documents/spots/$(spotDocumentId)).data.authorId == authorUid
        && firestore.get(/databases/(default)/documents/spots/$(spotDocumentId)).data.get('status', 'active') != 'deleting'
        && (
          firestore.get(/databases/(default)/documents/spots/$(spotDocumentId)).data.visibility == 'public' ||
          (
            firestore.get(/databases/(default)/documents/spots/$(spotDocumentId)).data.visibility == 'friends' &&
            firestore.exists(/databases/(default)/documents/users/$(authorUid)/friends/$(request.auth.uid))
          )
        );
    }

    // Spot photos: spots/{authorUid}/{spotId}/{filename}
    // Quyền đọc luôn bám theo visibility hiện tại của Spot, nên đổi visibility
    // có hiệu lực ngay với ảnh đã tải trước đó.
    match /spots/{authorUid}/{spotId}/{filename} {
      allow read: if isAuthenticated() && (
        request.auth.uid == authorUid ||
        spotIsReadableByViewer(authorUid, spotId)
      );

      // Chỉ tác giả được tải ảnh vào đúng thư mục Spot của mình.
      allow create, update: if isAuthenticated()
        && request.auth.uid == authorUid
        && isImage()
        && isUnder5MB();

      // Server (Admin SDK) dọn ảnh khi xóa Spot; client không xóa trực tiếp.
      allow delete: if false;
    }

    // Avatar photos: avatars/{uid}/{filename}
    match /avatars/{uid}/{filename} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.auth.uid == uid
                   && isImage()
                   && isUnder5MB();
    }
  }
}
