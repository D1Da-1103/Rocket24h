{
  "name": "rocket24h",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules\"",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --only auth,firestore,storage",
    "dev:emulated": "npm-run-all --parallel emulators dev",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "cleanup:media": "tsx --env-file=.env.local scripts/cleanup-media.ts"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "geofire-common": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
